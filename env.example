# Copy this file to ".env" and fill in your values.
# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model names change over time. If you see a 404 "model no longer available",
# check https://ai.google.dev/gemini-api/docs/models and update this value.
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated backups, tried in order if the main model fails.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview

# Long random string used to sign login tokens (JWT). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Comma-separated list of origins allowed to call the API from a browser (CORS)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# SQLite database file
DB_PATH=data/pocketsmart.db
HOST=127.0.0.1
PORT=8000
